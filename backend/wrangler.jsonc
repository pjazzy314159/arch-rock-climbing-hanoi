{
  "name": "arch-backend-worker",
  "main": "worker.py",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["python_workers"],
  "python_modules": {
  "exclude": [
    "**/*.pyc",
    "**/*.c",
    "**/__pycache__"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "225ffa662b9d480bbb9ce568f036ce99"
    }
  ],
  "vars": {
  "ARCH_ENVIRONMENT": "production",
  "CORS_ORIGINS": "https://arch-rock-climbing-hanoi.vercel.app"
  },
  "secrets": {
    "required": ["ARCH_SECRET_KEY"]
  }

}
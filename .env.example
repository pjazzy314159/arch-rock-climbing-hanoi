# ---------------------------------------------------------------------------
# ARCH Rock Climbing Hanoi — environment configuration
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# Every value below is a placeholder. Never commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# --- Frontend --------------------------------------------------------------

# Base URL of the FastAPI backend used by the browser.
# Leave empty to run the site in "offline / sample data" mode.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project used by the Lovable-generated integration scaffold.
# The scaffold is not wired to any table yet; the ARCH backend is authoritative.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Backend (FastAPI) -----------------------------------------------------

# SQLAlchemy connection string.
#   PostgreSQL (production / shared environments):
#     postgresql+psycopg://arch:arch@localhost:5432/arch
#   SQLite (zero-setup local development and the test suite):
#     sqlite:///./arch_dev.db
DATABASE_URL=sqlite:///./arch_dev.db

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be changed for any shared or deployed environment.
ARCH_SECRET_KEY=change-me-local-development-only

# Minutes before an issued access token expires.
ARCH_ACCESS_TOKEN_TTL_MINUTES=720

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8090

# Comma-separated list of trusted reverse-proxy headers, e.g. X-Forwarded-For.
TRUSTED_PROXY_HEADERS=

# --- AI assistant (optional) ----------------------------------------------
#
# The assistant runs fully offline against the approved knowledge base.
# Configure exactly one provider to enable live model answers. Credentials are
# read by the backend only and are never exposed to the browser.

# Free-tier options: https://console.groq.com , https://ai.google.dev
#   LLM_PROVIDER=groq
#   LLM_API_KEY=...
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Media (optional) ------------------------------------------------------

# Directory used for uploaded route/event media. Relative paths resolve from
# the backend working directory. Leave empty to use the in-repo default.
ARCH_MEDIA_ROOT=./var/media
